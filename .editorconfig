root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{dart,yaml,yml}]
indent_style = space
indent_size = 2

[*.{gradle,kt,java}]
indent_style = space
indent_size = 4

[*.{swift,m,h}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{json,js,ts,tsx,jsx}]
indent_style = space
indent_size = 2
