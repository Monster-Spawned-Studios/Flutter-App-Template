root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
max_line_length = 120

[*.{dart,yaml,yml}]
indent_style = space
indent_size = 2

[*.dart]
max_line_length = 120
indent_style = space
indent_size = 2

[*.{gradle,kt,java}]
max_line_length = 120
indent_style = space
indent_size = 4

[*.{swift,m,h}]
max_line_length = 120
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
max_line_length = 120
insert_final_newline = true

[*.{json,js,ts,tsx,jsx}]
max_line_length = 120
indent_style = space
indent_size = 2
