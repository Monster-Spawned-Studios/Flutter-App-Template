{
  "version": "0.2",
  "allowCompoundWords": true,
  "caseSensitive": false,
  "dictionaries": [
    "en_US",
    "en-gb",
    "companies",
    "softwareTerms",
    "misc",
    "typescript",
    "node",
    "npm",
    "html",
    "csharp",
    "bash",
    "python",
    "powershell",
    "filetypes",
    "Monster Spawned Studios Custom Dictionary",
    "Minecraft Dictionary",
    "Other Game Dictionary"
  ],
  "ignorePaths": [
    "node_modules",
    "dist",
    "public",
    ".github",
    ".astro",
    ".vscode",
    ".prettierrc",
    ".prettierignore",
    ".eslintrc",
    ".eslintrc-ignore",
    ".gitignore",
    ".gitattributes",
    ".git"
  ],
  "enabled": true,
  "description": "Custom spell checking for the Monster Spawned Studios blog",
  "ignoreWords": [
    ""
  ],
  "dictionaryDefinitions": [
    {
      "name": "Monster Spawned Studios Custom Dictionary",
      "path": "./dictionaries/mss-custom-dictionary.txt",
      "description": "Custom dictionary for Monster Spawned Studios' commonly used words.",
      "repMap": [
        [
          "'|`|’",
          "'"
        ]
      ]
    },
    {
      "name": "Minecraft Dictionary",
      "path": "./dictionaries/minecraft-words.txt",
      "description": "Custom dictionary for commonly used words regarding the game 'Minecraft'.",
      "repMap": [
        [
          "'|`|’",
          "'"
        ]
      ]
    },
    {
      "name": "Other Game Dictionary",
      "path": "./dictionaries/other-game-words.txt",
      "description": "Custom dictionary for commonly used words regarding other games that the Monster Spawned Studios blog may use.",
      "repMap": [
        [
          "'|`|’",
          "'"
        ]
      ]
    }
  ],
  "minWordLength": 5,
  "maxDuplicateProblems": 3,
  "useGitignore": true,
  "enabledFileTypes": {
    "*": true,
    "md": true,
    "astro": true,
    "json": true,
    "json5": true,
    "jsonc": true,
    "yaml": true,
    "yml": true,
    "html": true,
    "scss": true,
    "css": true,
    "js": true,
    "mjs": true,
    "jsx": true,
    "ts": true,
    "tsx": true,
    "txt": false,
    "log": false,
    "py": false,
    "sh": true,
    "svg": false,
    "dart": true,
    "kt": true,
    "java": true,
    "swift": true,
    "lock": false,
    "gradle": false
  }
}